# Webserver
HOST=0.0.0.0
PORT=3000

# Local iEast/LinkPlay streamer
IEAST_IP=192.168.1.100

# DLNA servers as a JSON array
MEDIA_SERVERS=[{"id":"primary","name":"My media server","url":"http://192.168.1.101:8200"}]

# Spotify Developer app
SPOTIFY_CLIENT_ID=

# Optional when deployed behind a reverse proxy
SPOTIFY_REDIRECT_URI=

# Optional persistent volume; defaults to .state inside the project
# STATE_DIR=/var/lib/ieast-controller
