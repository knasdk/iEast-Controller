{
  "name": "ieast-controller",
  "version": "1.0.3",
  "private": true,
  "description": "Local web controller for an iEast/LinkPlay streamer",
  "author": "knasdk",
  "desktopName": "ieast-controller.desktop",
  "main": "electron-main.js",
  "scripts": {
    "desktop": "electron .",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "start": "node server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dk.knas.ieastcontroller",
    "productName": "iEast Controller",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron-main.js",
      "server.js",
      "package.json",
      "public/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "artifactName": "iEast-Controller-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "iEast-Controller-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "iEast-Controller-Portable-${version}-${arch}.${ext}"
    }
  }
}
